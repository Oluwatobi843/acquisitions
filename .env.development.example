# Development (Neon Local). Copy to `.env.development`.
#   cp .env.development.example .env.development
# Never commit `.env.development` - it is gitignored.

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Secrets
JWT_SECRET=change-me-in-development
# Optional locally: without it Arcjet's security middleware will error.
ARCJET_KEY=

# Neon Cloud credentials - Neon Local is a proxy to a Neon cloud branch,
# so it still needs API access even though the app connects locally.
# Console: https://console.neon.tech -> Account Settings -> API Keys
NEON_API_KEY=
# Console: Project Settings -> General
NEON_PROJECT_ID=
# Branch to fork ephemeral dev branches from. Leave empty to use the
# project's default branch. Each `docker compose up` then creates a fresh
# branch and deletes it on `down`.
PARENT_BRANCH_ID=
# Set to `false` to keep ephemeral branches after shutdown.
DELETE_BRANCH=true

# The app container does not use this - docker-compose.dev.yml points it at
# `neon-local:5432` on the compose network. This is only for running
# `npm run dev` directly on the host.
DATABASE_URL=postgres://neon:npg@localhost:5432/neondb?sslmode=require
