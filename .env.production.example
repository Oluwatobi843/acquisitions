# Production. Copy to `.env.production` on the server, or export these as
# real environment variables from your secret manager / orchestrator.
#   cp .env.production.example .env.production
# Never commit `.env.production` - it is gitignored.

# Server Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Secrets - required. Compose refuses to start without these.
JWT_SECRET=
ARCJET_KEY=

# Neon Cloud - required. The production stack has no local database service.
# Console: https://console.neon.tech -> Connect -> pooled connection string
# Pooled (recommended for serverless HTTP):
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct:
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Migrations run from a one-off container in production, not on every boot.
RUN_MIGRATIONS=false
