# Copy to `.env` for local runs outside Docker.
# Never commit a filled-in `.env` - it is gitignored.

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Secrets - fill these in
JWT_SECRET=
ARCJET_KEY=

# Database Configuration
# Development with Docker Compose overrides this to Neon Local automatically.
DATABASE_URL=
